# Copy to .env (never commit). Generate secrets with: openssl rand -hex 32
PORT=8080
JWT_SECRET=change-me-32+bytes
ADMIN_TOKEN=change-me-admin-32+bytes
DB_PATH=./data/echora.db
# Online transcription proxy (optional). Key stays on the server.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Prices in BDT per 30 days (configurable)
PRICE_PLUS=99
PRICE_PRO=199
# Online transcription requests per calendar month
QUOTA_FREE=5
QUOTA_PLUS=100
QUOTA_PRO=500
# Shown in the app before the user pays; operator-provided official instructions
PAYMENT_INSTRUCTIONS=
